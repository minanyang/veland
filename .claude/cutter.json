{
  "base": "main",
  "gates": [
    "shellcheck bin/cutter-red-proof bin/cutter-review-packet bin/cutter-verify bin/cutter-worktree scripts/*.sh tests/*.sh",
    "node --check bin/cutter-ticket && node --check hooks/context-gate.js",
    "bash tests/guard-bash.test.sh",
    "bash tests/context-gate.test.sh",
    "bash tests/scripts.test.sh",
    "claude plugin validate ."
  ],
  "close": "pr-merge",
  "contextGate": {
    "maxTokens": 200000
  }
}
