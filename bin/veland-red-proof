#!/bin/bash
# Prove that a ticket's tests test the ticket: they must go red without the change.
#
#   veland-red-proof <id>            prove the changed tests go red without the implementation
#   veland-red-proof <id> --lock     the tests half: prove the tests fail before any implementation, then lock them
#
# "The string appears in a test" is not "the string is tested". A test that never imports
# the unit it names, or asserts a constant equals itself, stays green whatever the
# implementation does. This asks the question mechanically, before the review:
#
#   1. take the test files the branch added or modified (vs its merge base),
#   2. run them at HEAD — they must all pass, or a red below would prove nothing,
#   3. put every OTHER file the branch touched back to the merge base,
#   4. run only those test files again,
#   5. restore the tree to HEAD.
#
# A file that fails at HEAD — the wrong runner (mocha, ava, bun test and monorepo workspaces
# fall through to `node --test`), a broken test, missing environment — exits 2 before the
# tree is touched. Red is the pass. A changed test file with zero failing tests is a finding; in a test file
# the branch ADDED, every test that still passes is listed. A modified test file whose diff
# adds no test case (fixture / mock / comment edits) is expected to stay green and is
# reported as `note`. Not reverted: test helpers and fixtures, package.json and lockfiles
# (dependencies are not reinstalled).
#
# Runners: jest, vitest, else `node --test`. Any other stack declares its own in .claude/veland.json:
# `redProof.command` (a shell command with `{file}`, run once per test file in the worktree root)
# and `redProof.tests` (git pathspec globs naming the test files); a file is judged by its exit
# code, and a modified test file that stays green is GREEN (no `note` in this mode).
# The worktree must be clean. The tree is always restored on exit, and the ticket lock is
# shared with veland-verify. Agent memory (.claude/agent-memory/) is never checked, reverted
# or restored: agents may write it while red-proof runs.
# Exit: 0 every changed test file went red · 1 at least one stayed green · 2 could not run
# (including: a changed test file does not pass at HEAD).
#
# --lock (refused when the main checkout's .claude/veland.json has "tdd": false, or a lock exists) runs on a branch
# that holds only the tests half. It exits 2, naming what is wrong, when the branch changes no test file, a file that
# is neither a test file nor a test helper, or leaves out a test file `## Tests` of .veland/<id>/plan.md names; when
# its added lines in a test file hold an unconditional skip (`.skip(`, `xit(`, `it.todo(`, `{ skip: true }`); or when,
# run at HEAD, a changed test file passes or the runner reports a test skipped or todo (jest, vitest, node --test;
# a file missing from the report has not loaded yet and counts as failing). Report: red-proof/lock.json. Otherwise it
# records the lock in the worktree's git dir (scripts/lib.sh lock_write): the lock commit and the blob of every file
# the branch changed.
#
# With TDD on, the default mode exits 2 while there is no lock and `## Tests` names a test file. When a locked file
# differs from the lock it exits 2 unless the pending entries of .veland/<id>/relock.md (their commit not yet a lock),
# taken in file order, account for it: each `approved`, with a `reason`, its commit an ancestor of HEAD that changes
# only locked files and whose parent holds the locked files as the lock before it left them; and HEAD holds them as
# the last one left them. After that every file must still go red; the lock then moves through each relock commit.

set -uo pipefail
# shellcheck source=../scripts/lib.sh
source "$(dirname "$(readlink -f "$0")")/../scripts/lib.sh"

usage="usage: veland-red-proof <id> [--lock]"
id="${1:-}"; [ -n "$id" ] || die "$usage"
check_id "$id"
lock=""
case "${2:-}" in "") ;; --lock) lock=1 ;; *) die "$usage" ;; esac
[ $# -le 2 ] || die "$usage"
path="$(wt_path "$id")"
[ -z "$(tree_status "$path")" ] || die "the worktree has uncommitted changes; commit first (red-proof rewrites the tree)"
rp_config "$path"
base="$(git -C "$path" merge-base "$(base_ref)" HEAD)" || die "no merge base with $(base_ref)"
tdd=on; [ "$(cfg tdd)" != false ] || tdd=off
plan="$(task_dir "$id")/plan.md"
named=""
[ ! -f "$plan" ] || named="$(node -e 'console.log(require(process.argv[1]).testFiles(require("fs").readFileSync(process.argv[2], "utf8")).join("\n"))' \
  "$(dirname "$(readlink -f "$0")")/../scripts/md-check.js" "$plan")" || die "could not read the ## Tests table of $plan"

cmd_tests=""
[ -z "$rp_cmd" ] || cmd_tests="$(git -C "$path" diff -z --name-only "$base" HEAD -- "${rp_globs[@]}" | tr '\0' '\n')"
is_test() {
  if [ -n "$rp_cmd" ]; then printf '%s\n' "$cmd_tests" | grep -qxF -- "$1"
  else [[ "$1" =~ \.(test|spec)\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$ ]]; fi
}
is_helper() { [[ "$1" =~ (^|/)(__tests__|__mocks__|test|tests|fixtures|e2e)/ || "$1" =~ \.(stub|mock|fixture)\. ]]; }
is_pinned() { [[ "$1" =~ (^|/)(package\.json|pnpm-lock\.yaml|package-lock\.json|yarn\.lock|bun\.lockb?)$ ]]; }
adds_case() { git -C "$path" diff "$base" HEAD -- "$1" | grep -qE '^\+.*\b(it|test|describe)(\.(each|only|skip|concurrent))?\('; }

tests=(); added_tests=(); no_case=(); revert=(); remove=(); changed=(); pinned=()
while IFS= read -r -d '' status && IFS= read -r -d '' file; do
  [ -n "$file" ] || continue
  changed+=("$file")
  if is_test "$file"; then
    [ "$status" = D ] && continue
    tests+=("$file")
    if [ "$status" = A ]; then added_tests+=("$file"); elif [ -z "$rp_cmd" ] && ! adds_case "$file"; then no_case+=("$file"); fi
  elif is_helper "$file"; then
    continue
  elif is_pinned "$file"; then
    pinned+=("$file")
  elif [ "$status" = A ]; then
    remove+=("$file")
  else
    revert+=("$file")
  fi
done < <(git -C "$path" diff -z --name-status --no-renames "$base" HEAD -- . "$MEMORY_EXCLUDE")

relocks=()
if [ -n "$lock" ]; then
  [ "$tdd" = on ] || die "tdd is false in $CONFIG: there is no tests half to lock"
  [ ! -f "$(lock_path "$path")" ] || die "$id is already locked; a change to a locked file goes through a relock"
  [ ${#tests[@]} -gt 0 ] || die "$id: the branch changes no test file — write the tests ## Tests names first"
  [ -n "$named" ] || die "$id: ## Tests of $plan names no test file"
  [ $(( ${#revert[@]} + ${#remove[@]} + ${#pinned[@]} )) -eq 0 ] ||
    die "$id: the tests half changes only test files and test helpers; not one:$(printf ' %s' "${revert[@]:-}" "${remove[@]:-}" "${pinned[@]:-}" | tr -s ' ')"
  missing=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    printf '%s\n' "${changed[@]}" | grep -qxF -- "$f" || missing+=("$f")
  done <<<"$named"
  [ ${#missing[@]} -eq 0 ] || die "$id: ## Tests names test files the branch does not change: ${missing[*]}"
  skips=""
  for t in "${tests[@]}"; do
    hits="$(git -C "$path" diff "$base" HEAD -- "$t" | awk '/^@@/ { h = 1; next } h && /^\+/' |
      grep -E '\.skip\(|(^|[^[:alnum:]_$])xit\(|(^|[^[:alnum:]_$.])it\.todo\(|\{ *skip: *true *\}' | sed 's/^+//')" &&
      skips+="$(printf '%s\n' "$hits" | awk -v t="$t" '{ print "  " t ": " $0 }')"$'\n'
  done
  [ -z "$skips" ] || { printf '%s' "$skips" >&2; die "$id: an unconditional skip in the tests half — every test must run and fail"; }
else
  if [ "$tdd" = on ] && [ ! -f "$(lock_path "$path")" ] && [ -n "$named" ]; then
    die "$id has no lock: run the tests half first: veland-red-proof $id --lock"
  fi
  locked="$(lock_changed "$path")"
  if [ -n "$locked" ]; then
    lock_shas="$(lock_commits "$path")"
    # The pending relocks, in file order, each from the locked blobs the one before it left.
    state="$(sed -n 's/^file //p' "$(lock_path "$path")")"
    differs() { # <rev> — each locked path whose blob at <rev> is not the one in $state
      local line b p now
      while IFS= read -r line; do
        b="${line%% *}"; p="${line#* }"
        now="$(git -C "$path" rev-parse -q --verify "$1:$p")" || now=""
        [ "$now" = "$b" ] || printf '%s\n' "$p"
      done <<<"$state"
    }
    blobs_at() { # <rev> — $state's paths with their blobs at <rev>
      local line p
      while IFS= read -r line; do
        p="${line#* }"
        printf '%s %s\n' "$(git -C "$path" rev-parse -q --verify "$1:$p")" "$p"
      done <<<"$state"
    }
    why=""; last_n=""; last_verdict=""; p_n=""
    while IFS=$'\x1f' read -r n verdict commit reason _; do
      last_n=$n; last_verdict=$verdict
      [ -n "$commit" ] || continue
      sha="$(git -C "$path" rev-parse -q --verify "$commit^{commit}")" || sha="$commit"
      ! printf '%s\n' "$lock_shas" | grep -qxF -- "$sha" || continue
      if [ "$verdict" != approved ]; then why="relock $n is not approved"
      elif [ -z "$reason" ]; then why="relock $n has no reason"
      elif ! git -C "$path" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then why="relock $n's commit $sha is not an ancestor of HEAD"
      else
        outside="$(comm -23 <(git -C "$path" diff -z --name-only --no-renames "$sha^" "$sha" -- . "$MEMORY_EXCLUDE" | tr '\0' '\n' | sort) <(lock_files "$path" | sort))"
        before="$(differs "$sha^")"
        if [ -n "$outside" ]; then why="relock $n's commit ${sha:0:9} changes files that are not locked: ${outside//$'\n'/ }"
        elif [ -n "$before" ]; then why="${before//$'\n'/ } changed before relock $n's commit ${sha:0:9}, outside a relock"
        fi
      fi
      [ -z "$why" ] || break
      state="$(blobs_at "$sha")"; relocks+=("$sha"); p_n=$n
    done < <(relock_entries "$(task_dir "$id")/relock.md")
    if [ -z "$why" ]; then
      after="$(differs HEAD)"
      if [ ${#relocks[@]} -eq 0 ]; then why="no pending relock entry with a commit in $(task_dir "$id")/relock.md"
      elif [ -n "$after" ]; then why="${after//$'\n'/ } differs at HEAD from relock $p_n's commit ${relocks[${#relocks[@]}-1]:0:9}"
      fi
    fi
    if [ -n "$why" ]; then
      [ "$last_verdict" != rejected ] || why+=" (relock $last_n was rejected)"
      die "$id: locked file(s) changed since the lock: ${locked//$'\n'/ } — $why"
    fi
  fi
fi

if [ ${#tests[@]} -eq 0 ]; then
  say "$id: the branch adds or modifies no test file — nothing to prove."
  say "  (If the plan names behaviour to verify, that is itself a finding for the reviewer.)"
  exit 0
fi
if [ -z "$lock" ] && [ $(( ${#revert[@]} + ${#remove[@]} )) -eq 0 ]; then
  say "$id: the branch changes only tests and test helpers — there is no implementation to take away."
  exit 0
fi

out="$(task_dir "$id")/red-proof"
mkdir -p "$out"
take_lock "$id"
# shellcheck disable=SC2329  # run by the EXIT trap below
restore() {
  git -C "$path" restore --source=HEAD --staged --worktree -- . "$MEMORY_EXCLUDE" 2>/dev/null
  release_lock
  [ -z "$(tree_status "$path")" ] || echo "!! the worktree did NOT return to HEAD cleanly — inspect: git -C $path status" >&2
}
trap restore EXIT

runner_exec "$path"
runner="$(test_runner "$path")"

run_tests() { # <json> <log> — run the changed test files, write a jest-shaped report
  local json=$1 log=$2 t st sep=''
  rm -f "$json"
  case "$runner" in
    jest)   ( cd "$path" && "${exec_cmd[@]}" jest --ci --silent --json --outputFile="$json" "${tests[@]}" ) >"$log" 2>&1 ;;
    vitest) ( cd "$path" && "${exec_cmd[@]}" vitest run --reporter=json --outputFile="$json" "${tests[@]}" ) >"$log" 2>&1 ;;
    custom)
      : >"$log"
      printf '{"testResults":[' >"$json"
      for t in "${tests[@]}"; do
        ( cd "$path" && bash -c "$(rp_fill "$t")" ) >>"$log" 2>&1 && st=passed || st=failed
        printf '%s{"name":"%s","status":"%s","assertionResults":[]}' "$sep" "$path/$t" "$st" >>"$json"; sep=','
      done
      printf ']}' >>"$json" ;;
    *)
      : >"$log"
      printf '{"testResults":[' >"$json"
      for t in "${tests[@]}"; do
        ( cd "$path" && node --test --test-reporter=tap "$t" ) >"$log.tap" 2>&1 && st=passed || st=failed
        cat "$log.tap" >>"$log"
        printf '%s{"name":"%s","status":"%s","skipped":%s,"assertionResults":[]}' "$sep" "$path/$t" "$st" \
          "$(awk '/^# (skipped|todo) [0-9]+$/ { n += $3 } END { print n + 0 }' "$log.tap")" >>"$json"; sep=','
      done
      rm -f "$log.tap"
      printf ']}' >>"$json" ;;
  esac
}

if [ -n "$lock" ]; then
  # The tests half: no implementation yet, so every changed test file must fail as it stands, and none may skip.
  run_tests "$out/lock.json" "$out/lock.log"
  [ -s "$out/lock.json" ] || { tail -20 "$out/lock.log" >&2; die "the runner ($runner) produced no report — see $out/lock.log"; }
  node - "$out/lock.json" "$path" "${tests[@]}" <<'NODE' || die "$id: the tests half must fail before any implementation, and run every test (log: $out/lock.log)"
const [, , jsonPath, root, ...expected] = process.argv
const path = require('path')
const report = JSON.parse(require('fs').readFileSync(jsonPath, 'utf8'))
const byFile = new Map((report.testResults || []).map((r) => [path.relative(root, r.name), r]))
let bad = 0
for (const f of expected) {
  const r = byFile.get(f)
  if (!r) continue
  const tests = r.assertionResults || []
  const skipped = tests.filter((t) => t.status !== 'passed' && t.status !== 'failed').length + (r.skipped || 0)
  if (skipped) { bad++; console.error(`  ${f}: ${skipped} test(s) skipped or todo`) }
  if (r.status !== 'failed' && !tests.some((t) => t.status === 'failed')) { bad++; console.error(`  ${f}: passes with no implementation`) }
}
process.exit(bad ? 1 : 0)
NODE
  lock_write "$path" HEAD
  say "locked $(lock_files "$path" | wc -l | tr -d ' ') file(s) at $(git -C "$path" rev-parse --short HEAD)"
  exit 0
fi

# At HEAD first: a file that cannot pass with the change would go red without it too.
run_tests "$out/head.json" "$out/head.log"
[ -s "$out/head.json" ] || { tail -20 "$out/head.log" >&2; die "the runner ($runner) produced no report at HEAD — see $out/head.log"; }
node - "$out/head.json" "$path" "${tests[@]}" <<'NODE' || die "these test files do not pass at HEAD with $runner, so red without the change would prove nothing — fix the test or its environment, or this is a runner red-proof does not support (log: $out/head.log)"
const [, , jsonPath, root, ...expected] = process.argv
const path = require('path')
const report = JSON.parse(require('fs').readFileSync(jsonPath, 'utf8'))
const byFile = new Map((report.testResults || []).map((r) => [path.relative(root, r.name), r]))
const bad = expected.filter((f) => { const r = byFile.get(f); return !r || r.status !== 'passed' })
for (const f of bad) console.error(`  ${f}: ${byFile.has(f) ? 'fails' : 'missing from the report'}`)
process.exit(bad.length ? 1 : 0)
NODE

[ ${#revert[@]} -gt 0 ] && git -C "$path" restore --source="$base" --staged --worktree -- "${revert[@]}"
for f in "${remove[@]:-}"; do [ -n "$f" ] && rm -f "$path/$f"; done

json="$out/report.json"; log="$out/run.log"
run_tests "$json" "$log"

say "$id · red-proof against merge base ${base:0:9} · runner: $runner"
say "  reverted ${#revert[@]} file(s), removed ${#remove[@]} added file(s), ran ${#tests[@]} changed test file(s)"
say ""

[ -s "$json" ] || { tail -20 "$log" >&2; die "the runner produced no report — see $log"; }

ADDED="$(printf '%s\n' "${added_tests[@]:-}")" NOCASE="$(printf '%s\n' "${no_case[@]:-}")" node - "$json" "$path" "${tests[@]}" <<'NODE'
const [, , jsonPath, root, ...expected] = process.argv
const path = require('path')
const added = new Set((process.env.ADDED || '').split('\n').filter(Boolean))
const noCase = new Set((process.env.NOCASE || '').split('\n').filter(Boolean))
const report = JSON.parse(require('fs').readFileSync(jsonPath, 'utf8'))
const byFile = new Map()
for (const r of report.testResults || []) byFile.set(path.relative(root, r.name), r)
let green = 0, note = 0
for (const file of expected) {
  const r = byFile.get(file)
  if (!r) { console.log(`RED    ${file}\n         did not load at all without the change`); continue }
  const tests = r.assertionResults || []
  const failed = tests.filter((t) => t.status === 'failed')
  const passed = tests.filter((t) => t.status === 'passed')
  const red = r.status === 'failed' || failed.length > 0
  if (!red) {
    if (noCase.has(file)) {
      note++
      console.log(`note   ${file}\n         modified without adding a test case — ${passed.length} test(s) still pass, as expected`)
      continue
    }
    green++
    console.log(`GREEN  ${file}\n         ${passed.length} test(s) pass with the implementation reverted — this file does not test the change`)
    continue
  }
  const why = (failed[0]?.failureMessages?.[0] || r.message || '').split('\n').find((l) => l.trim()) || ''
  if (!tests.length) { console.log(`RED    ${file}\n         the file failed without the change (per-test results not available from this runner — see the run log)`); continue }
  console.log(`RED    ${file}   ${failed.length} failed / ${passed.length} passed\n         first error: ${why.trim().slice(0, 160)}`)
  if (added.has(file) && passed.length) {
    console.log(`         new tests that pass WITHOUT the change (${passed.length}):`)
    for (const t of passed.slice(0, 20)) console.log(`           · ${t.fullName || t.title}`)
  }
}
console.log()
console.log(green ? `${green} changed test file(s) stayed GREEN without the change.` : `Every test file that adds a case went red without the change.${note ? ` (${note} fixture-only edit(s) noted.)` : ''}`)
process.exit(green ? 1 : 0)
NODE
rc=$?
if [ "$rc" -eq 0 ] && [ ${#relocks[@]} -gt 0 ]; then
  for c in "${relocks[@]}"; do
    lock_write "$path" "$c"
    say "relocked at $(git -C "$path" rev-parse --short "$c")"
  done
fi
exit "$rc"
