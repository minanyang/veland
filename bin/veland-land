#!/bin/bash
# The writes /veland:close, /veland:open and /veland:work need, each taking only a ticket id or a draft slug — the command
# line is built here, so a permission rule for `veland-land <sub> *` cannot be stretched into a force-push,
# a bypass or a publish of another file or repo.
#
#   veland-land check  <id>
#   veland-land rebase <id>
#   veland-land push   <id>
#   veland-land merge  <id>
#   veland-land wait   <id>
#   veland-land squash <id>
#   veland-land pr     <id>
#   veland-land issue  <slug>
#   veland-land comment <id>
#
# `check` first prints the configured close mode, `mode: <close>` (exit 2 on a value other than pr, pr-merge or local,
# before looking for the worktree), then, still before the worktree lookup, `ticket dir: <abs .veland/<id>>`,
# `base: <branch> (<ref>)`, and `review: <abs path>` or `review: missing`. In pr or pr-merge mode with a github.com origin it then prints the branch's PR,
# `pr: <STATE> <url>`, or `pr: none` when gh finds none, and in pr or pr-merge mode the PR/MR template the body must
# follow, `pr template: <path>` relative to the worktree, or `pr template: none`. It exits 1 and lists the files when the
# ticket's worktree has uncommitted changes.
# The template is looked up in the worktree: on a GitLab origin in .gitlab/merge_request_templates/, otherwise
# .github/pull_request_template.md, pull_request_template.md, docs/pull_request_template.md, then
# .github/PULL_REQUEST_TEMPLATE/; first found wins. Names match in any case; a symlink anywhere on the way does not
# count. A directory counts when it holds exactly one .md file, or (GitLab) a Default.md.
# `rebase` fetches origin and rebases the ticket branch onto origin/<base> (in local mode, onto the local
# base when it contains origin/<base>; refused when the two have diverged); on a conflict it lists
# the files and leaves the rebase for the user (never --skip).
# `push` pushes the ticket branch, and only it, to origin; --force-with-lease only when origin
# already has the branch (never a plain force-push). It refuses the base branch.
# `merge` squash-merges the branch's open PR/MR (gh for github.com, glab for a GitLab host) after
# checking that its base is the configured base and that it is not a fork's; pinned to origin's repo
# and to the worktree's HEAD sha (--match-head-commit / --sha). On GitHub it also refuses unless the PR's head is
# the worktree's HEAD, the branch contains origin/<base> after a fetch, and its checks are all green; no checks at all
# counts as pending only when a workflow under .github/workflows/ on the branch or the base mentions pull_request.
# Exit 4: origin/<base> moved since the rebase. Exit 3: the only objection is checks still running or not yet
# registered (named). Failed checks, and every other refusal, exit 2. Never --admin, never the delete-branch flags.
# `wait` (github.com only) checks the PR like `merge`, then polls its checks with the same rule every
# $VELAND_WAIT_INTERVAL seconds (30) until they are all green (exit 0), any fails (exit 1, failed checks named) or
# $VELAND_WAIT_CAP seconds (1800) pass (exit 1, pending checks named). A PR head other than the worktree's HEAD exits 2.
# `squash` (local mode) lands the ticket branch on the base as one commit with .veland/<id>/commit-msg as its
# message; for a gh-<n> id whose commit-msg has no `Closes #<n>` line it adds one as its own paragraph, before a
# closing trailer block or else last, so pushing the base closes the issue. It refuses unless the branch is rebased
# onto the base. With the main checkout on the base it
# fast-forwards it, keeping uncommitted changes to files the squash does not touch.
# `pr` opens the ticket's PR/MR from .veland/<id>/pr-title and pr-body.md, or, when the branch already
# has an open one, replaces only its body; on GitHub it refuses a branch whose PR is already merged. It refuses,
# before any gh or glab call, a pr-body.md lacking any `##` heading of the worktree's template (as `check` finds it),
# naming the missing ones; headings match trimmed, in any case, without closing #s, fenced ones ignored. The repo is
# pinned to origin; no auto-merge, push or fill flags.
# `push`, `merge` and `pr` refuse when an origin push URL names a different repo than its fetch URL.
# `issue` (github.com only) creates an issue from .veland/drafts/<slug>.md (title, Labels:, Type:, Form:, body);
# every label must already exist in the repo. When the main checkout has issue forms (.github/ISSUE_TEMPLATE/*.yml
# besides config.yml) the draft's `Form: <file>` must name one, and every required field's `### <label>` section must
# have content; without forms the body needs a `## Acceptance criteria` section. Either way each checkbox criterion
# there needs `AC<n>` + a dash or colon, one per line, and no phrase of references/banned-phrases.txt may appear
# outside code. Any refusal exits 2 before `gh issue create`. Once `gh issue create` succeeds the draft is deleted;
# when it fails, the draft stays and the script exits with gh's code.
# `comment` (github.com only) posts .veland/<id>/comment.md as a comment on issue <n> of id gh-<n>, in origin's
# repo, only when the url in .veland/<id>/ticket.md's header is that issue's, then renames it to comment.posted.md;
# it needs no worktree, since /veland:work posts it while planning.

set -euo pipefail
# shellcheck source=../scripts/lib.sh
source "$(dirname "$(readlink -f "$0")")/../scripts/lib.sh"

usage="usage: veland-land check|rebase|push|merge|wait|squash|pr|comment <id> | issue <slug>"
cmd="${1:-}"; id="${2:-}"
[ $# -eq 2 ] || die "$usage"
if [ "$cmd" = issue ]; then
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid draft slug '$id' (lowercase letters, digits, -)"
elif [ "$cmd" = comment ]; then
  [[ "$id" =~ ^gh-([1-9][0-9]*)$ ]] || die "comment needs a GitHub issue ticket id gh-<n>, got '$id'"
  number="${BASH_REMATCH[1]}"
else
  check_id "$id"
  if [ "$cmd" = check ]; then
    # Printed before the worktree lookup, so /veland:close has the mode even when the ticket has no worktree.
    mode="$(cfg close pr)"
    shown="$(shown "$mode")"
    say "mode: $shown"
    case "$mode" in pr|pr-merge|local) ;; *) die "unknown close mode '$shown' in .claude/veland.json (want pr, pr-merge or local)" ;; esac
    ticket_lines "$id"
    review="$(task_dir "$id")/review.md"
    if [ -f "$review" ] && [ ! -L "$review" ]; then say "review: $(shown "$review")"; else say "review: missing"; fi
  fi
  path="$(wt_path "$id")"
  branch="$(git -C "$path" rev-parse --abbrev-ref HEAD)"
  base="$(base_branch)"
  # A leading + or a : would turn the branch into a forced or re-targeted refspec.
  case "$branch" in +*|*:*) die "refusing branch name '$branch': a leading + or a : is not allowed" ;; esac
fi
has_origin() { git -C "$ROOT" remote get-url origin >/dev/null 2>&1; }

# Sets o_host and o_path (the repo path, groups included) from a remote URL.
url_parts() {
  local u="$1"
  u="${u%/}"; u="${u%.git}"
  o_host=""
  if [[ "$u" == *://* ]]; then
    u="${u#*://}"; o_host="${u%%/*}"; o_host="${o_host##*@}"; o_host="${o_host%%:*}"; o_path="${u#*/}"
  elif [[ "$u" =~ ^([^/:]+@)?([^/:]+):(.+)$ ]]; then
    o_host="${BASH_REMATCH[2]}"; o_path="${BASH_REMATCH[3]}"
  else
    o_path="${u#/}"
  fi
}
origin_parts() { url_parts "$(git -C "$ROOT" remote get-url origin)"; }
# Every URL origin pushes to must name the repo it fetches from, or the branch lands in one repo
# while the PR/MR is opened or merged in another.
same_push_url() {
  local fetch want p
  fetch="$(git -C "$ROOT" remote get-url origin)"
  url_parts "$fetch"; want="$o_host/$o_path"
  while IFS= read -r p; do
    url_parts "$p"
    [ "$o_host/$o_path" = "$want" ] || die "origin pushes to $p but fetches from $fetch; point both at the same repo"
  done < <(git -C "$ROOT" remote get-url --push --all origin)
}
# github.com/OWNER/REPO for gh (the last two path segments), host included so GH_HOST cannot redirect it.
gh_repo() {
  local o r
  origin_parts
  r="${o_path##*/}"; o="${o_path%/*}"; o="${o##*/}"
  [[ "$o/$r" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "cannot derive OWNER/REPO from origin"
  printf 'github.com/%s/%s\n' "$o" "$r"
}
# The full https URL of origin's project for glab -R: the one form that also pins a self-hosted host.
glab_repo() {
  origin_parts
  [ -n "$o_host" ] && [[ "$o_path" =~ ^[A-Za-z0-9._/-]+$ ]] || die "cannot derive the project URL from origin"
  printf 'https://%s/%s\n' "$o_host" "$o_path"
}
# "<base> <state> <cross-repo>" of the branch's PR in $repo, and "<base> <state> <same-project>" of its MR:
# a fork's PR/MR with the same branch name is never the ticket's.
gh_view() {
  gh pr view "$branch" --repo "$repo" --json baseRefName,state,isCrossRepository \
    --jq '.baseRefName + " " + .state + " " + (.isCrossRepository | tostring)'
}
# "<state> <url>" of the branch's PR in $repo; nothing for a fork's.
gh_pr_state() {
  gh pr view "$branch" --repo "$repo" --json state,url,isCrossRepository \
    --jq 'select(.isCrossRepository | not) | .state + " " + .url'
}
# One line per check on the PR that is not green, "pending <name>: <state>" while it runs and "failed <name>: <state>"
# once it has failed; "head <sha>" if the PR's head is not the worktree's HEAD, and "none" if it has no checks at all.
# Empty output means all green.
gh_checks() {
  gh pr view "$branch" --repo "$repo" --json headRefOid,statusCheckRollup \
    | node -e '
      const r = JSON.parse(require("fs").readFileSync(0, "utf8")), head = process.argv[1]
      if (r.headRefOid !== head) { console.log("head " + r.headRefOid); process.exit(0) }
      const rollup = r.statusCheckRollup || []
      if (!rollup.length) { console.log("none"); process.exit(0) }
      for (const c of rollup) {
        const name = c.name || c.context
        if (c.__typename === "StatusContext") {
          if (["PENDING", "EXPECTED"].includes(c.state)) console.log("pending " + name + ": " + c.state)
          else if (c.state !== "SUCCESS") console.log("failed " + name + ": " + c.state)
        } else if (c.status !== "COMPLETED") console.log("pending " + name + ": " + c.status)
        else if (!["SUCCESS", "SKIPPED", "NEUTRAL"].includes(c.conclusion)) console.log("failed " + name + ": " + c.conclusion)
      }
    ' "$(git -C "$path" rev-parse HEAD)"
}
# Sets $failed and $pending, one "<name>: <state>" per line, from the PR's checks; dies when the PR's head is not the
# worktree's HEAD. The one rule `merge` and `wait` both judge by.
checks_state() {
  local out line
  out="$(gh_checks)" || die "could not read the checks of $branch"
  failed=""; pending=""
  case "$out" in
    head\ *) die "PR head ${out#head } is not the worktree's HEAD — push first" ;;
    none)
      # The base's workflows count too: a branch that deletes its trigger does not opt itself out.
      if git -C "$path" grep -q pull_request HEAD -- .github/workflows 2>/dev/null ||
         git -C "$path" grep -q pull_request "$(base_ref)" -- .github/workflows 2>/dev/null; then
        pending="no checks yet, but a workflow runs on pull_request"
      fi
      return 0 ;;
  esac
  while IFS= read -r line; do
    case "$line" in
      failed\ *) failed+="${line#failed }"$'\n' ;;
      pending\ *) pending+="${line#pending }"$'\n' ;;
    esac
  done <<<"$out"
  failed="${failed%$'\n'}"; pending="${pending%$'\n'}"
}
glab_view() {
  glab mr view "$branch" -R "$repo" --output json \
    | node -e 'const m = JSON.parse(require("fs").readFileSync(0, "utf8")); console.log(m.target_branch + " " + m.state + " " + (Number.isInteger(m.source_project_id) && m.source_project_id === m.target_project_id))'
}
# Names travel in variables, never through $(...): it would strip a trailing newline and turn a decoy name back into
# the symlink beside it.
# Sets $lc to <s> in lower case.
lower() { lc="$(printf '%s.' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]')"; lc="${lc%.}"; }
# Sets $ci to the name of the entry of <dir> called <name> in any case, the first in byte order, never a symlink;
# 1 when none.
ci_entry() {
  local LC_ALL=C want e
  lower "$2"; want="$lc"
  for e in "$1"/* "$1"/.[!.]*; do
    [ ! -L "$e" ] && [ -e "$e" ] && lower "${e##*/}" && [ "$lc" = "$want" ] || continue
    ci="${e##*/}"; return 0
  done
  return 1
}
# Sets $tpl to the worktree's PR/MR template relative to it, or empty (the rules are in the header).
pr_template() {
  local cands c segs seg dir rel f files
  tpl=""
  if has_origin && origin_parts && [[ "$o_host" == *gitlab* ]]; then
    cands=(.gitlab/merge_request_templates/)
  else
    cands=(.github/pull_request_template.md pull_request_template.md docs/pull_request_template.md .github/PULL_REQUEST_TEMPLATE/)
  fi
  for c in "${cands[@]}"; do
    dir="$path"; rel=""
    IFS=/ read -ra segs <<<"${c%/}"
    for seg in "${segs[@]}"; do
      ci_entry "$dir" "$seg" || continue 2
      dir="$dir/$ci"; rel="${rel:+$rel/}$ci"
      [ ! -L "$dir" ] || continue 2
    done
    if [ "$c" = "${c%/}" ]; then
      [ -f "$dir" ] && { tpl="$rel"; return 0; }
      continue
    fi
    [ -d "$dir" ] || continue
    if [[ "$c" == .gitlab/* ]] && ci_entry "$dir" Default.md && [ ! -L "$dir/$ci" ] && [ -f "$dir/$ci" ]; then
      tpl="$rel/$ci"; return 0
    fi
    files=()
    for f in "$dir"/*; do
      [ ! -L "$f" ] && [ -f "$f" ] && lower "${f##*/}" && [[ "$lc" == *.md ]] && files+=("${f##*/}")
    done
    [ ${#files[@]} -eq 1 ] && { tpl="$rel/${files[0]}"; return 0; }
  done
  return 0
}
# A regular, non-empty file with one link, really inside .veland/ (no symlink anywhere on the way), or die.
need_file() {
  [ ! -L "$1" ] && [ -f "$1" ] && [ -s "$1" ] || die "$1 is missing, empty or a symlink"
  [ ! -L "$ROOT/.veland" ] && [[ "$(readlink -f "$1")" == "$(readlink -f "$ROOT/.veland")/"* ]] || die "$1 resolves outside .veland/"
  [ -n "$(find "$1" -maxdepth 0 -links 1)" ] || die "$1 has more than one hard link"
}

case "$cmd" in
  check)
    if [ "$mode" = pr ] || [ "$mode" = pr-merge ]; then
      if has_origin && origin_parts && [ "$o_host" = github.com ]; then
        state="$( (repo="$(gh_repo)" && gh_pr_state) 2>/dev/null)" || state=""
        say "pr: ${state:-none}"
      fi
      pr_template
      say "pr template: $(shown "${tpl:-none}")"
    fi
    dirty="$(git -C "$path" status --porcelain)"
    if [ -n "$dirty" ]; then
      say "uncommitted changes in $path:"; say "$dirty"; exit 1
    fi
    say "clean: $path"
    ;;

  rebase)
    # An explicit refspec, as in merge: a narrowed remote.origin.fetch would leave origin/<base> stale.
    has_origin && { git -C "$ROOT" fetch --quiet origin "+refs/heads/$base:refs/remotes/origin/$base" || die "could not fetch origin/$base"; }
    ! base_diverged || die "$(base_branch) and origin/$(base_branch) have diverged — reconcile the local base first"
    if git -C "$path" rebase "$(base_ref)" >/dev/null 2>&1; then
      say "rebased $branch onto $(base_ref)"
    else
      say "rebase conflict — left in progress in $path; conflicting files:"
      git -C "$path" diff --name-only --diff-filter=U
      exit 1
    fi
    ;;

  push)
    [ "$branch" != "$base" ] || die "refusing to push the base branch $base"
    has_origin || die "no origin to push to"
    same_push_url
    if git -C "$ROOT" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null 2>&1; then
      git -C "$path" push --force-with-lease="refs/heads/$branch" -u origin "refs/heads/$branch:refs/heads/$branch"
    else
      git -C "$path" push -u origin "refs/heads/$branch:refs/heads/$branch"
    fi
    ;;

  merge)
    has_origin || die "no origin"
    same_push_url
    origin_parts
    case "$o_host" in
      github.com)
        repo="$(gh_repo)"
        got="$(gh_view)" || die "no PR found for $branch"
        [ "$got" = "$base OPEN false" ] || die "PR of $branch is '$got', want '$base OPEN false' (base, state, from a fork)"
        # An explicit refspec: a narrowed remote.origin.fetch would leave origin/<base> stale and the check below moot.
        git -C "$ROOT" fetch --quiet origin "+refs/heads/$base:refs/remotes/origin/$base" || die "could not fetch origin/$base"
        if ! git -C "$path" merge-base --is-ancestor "refs/remotes/origin/$base" HEAD; then
          say "veland: origin/$base moved since $branch was rebased — rebase again" >&2; exit 4
        fi
        checks_state
        [ -z "$failed" ] || die "checks of $branch failed:"$'\n'"$failed${pending:+$'\n'still pending:$'\n'$pending}"
        if [ -n "$pending" ]; then
          say "veland: checks of $branch are still pending:"$'\n'"$pending" >&2; exit 3
        fi
        gh pr merge "$branch" --repo "$repo" --squash --match-head-commit "$(git -C "$path" rev-parse HEAD)"
        ;;
      *gitlab*)
        repo="$(glab_repo)"
        got="$(glab_view)" || die "no MR found for $branch"
        [ "$got" = "$base opened true" ] || die "MR of $branch is '$got', want '$base opened true' (base, state, same project)"
        glab mr merge "$branch" -R "$repo" --squash --yes --sha "$(git -C "$path" rev-parse HEAD)"
        ;;
      *) die "origin host '$o_host' is neither github.com nor a GitLab host" ;;
    esac
    ;;

  wait)
    has_origin || die "no origin"
    origin_parts
    [ "$o_host" = github.com ] || die "wait needs a github.com origin"
    cap="${VELAND_WAIT_CAP:-1800}"; interval="${VELAND_WAIT_INTERVAL:-30}"
    [[ "$cap" =~ ^[0-9]+$ && "$interval" =~ ^[0-9]+$ ]] || die "VELAND_WAIT_CAP and VELAND_WAIT_INTERVAL must be whole seconds"
    repo="$(gh_repo)"
    got="$(gh_view)" || die "no PR found for $branch"
    [ "$got" = "$base OPEN false" ] || die "PR of $branch is '$got', want '$base OPEN false' (base, state, from a fork)"
    start=$SECONDS
    while :; do
      checks_state
      if [ -n "$failed" ]; then say "checks of $branch failed:"; say "$failed"; exit 1; fi
      if [ -z "$pending" ]; then say "checks of $branch are green"; exit 0; fi
      if [ $((SECONDS - start)) -ge "$cap" ]; then say "checks of $branch still pending after ${cap}s:"; say "$pending"; exit 1; fi
      sleep "$interval"
    done
    ;;

  squash)
    [ "$branch" != "$base" ] || die "the ticket branch is the base branch"
    td="$(task_dir "$id")"
    need_file "$td/commit-msg"
    ! base_diverged || die "$base and origin/$base have diverged — reconcile the local base first"
    # The ref the branch was rebased onto: the local base, or origin/<base> when the local base is behind it.
    onto="$(base_ref)"
    git -C "$ROOT" merge-base --is-ancestor "$onto" "refs/heads/$branch" || die "$onto moved since the rebase — rebase again"
    [ "$(git -C "$ROOT" rev-parse "$onto")" != "$(git -C "$ROOT" rev-parse "refs/heads/$branch")" ] || die "$branch has no commits beyond $onto"
    # Rebased onto the base, the branch's tree is the squashed result.
    if [[ "$id" =~ ^gh-([1-9][0-9]*)$ ]] && ! grep -qE "^Closes #${BASH_REMATCH[1]}[[:space:]]*$" "$td/commit-msg"; then
      # Closes #<n> as its own paragraph, before a closing trailer block so git still reads the trailers.
      commit="$(awk -v closes="Closes #${BASH_REMATCH[1]}" '
        { line[NR] = $0 }
        END {
          n = NR; while (n > 0 && line[n] ~ /^[[:space:]]*$/) n--
          b = n; while (b > 0 && line[b] !~ /^[[:space:]]*$/) b--
          text = 0; for (i = 1; i < b; i++) if (line[i] !~ /^[[:space:]]*$/) text = 1
          trailers = text; for (i = b + 1; i <= n; i++) if (line[i] !~ /^[A-Za-z0-9][A-Za-z0-9-]*:[[:space:]]/) trailers = 0
          if (trailers) { for (i = 1; i <= b; i++) print line[i]; print closes; print ""; for (i = b + 1; i <= n; i++) print line[i] }
          else { for (i = 1; i <= n; i++) print line[i]; print ""; print closes }
        }' "$td/commit-msg" | git -C "$ROOT" commit-tree "refs/heads/$branch^{tree}" -p "$onto" -F -)"
    else
      commit="$(git -C "$ROOT" commit-tree "refs/heads/$branch^{tree}" -p "$onto" -F "$td/commit-msg")"
    fi
    if [ "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)" = "$base" ]; then
      # Like sync-base: uncommitted changes to files the squash does not touch are kept.
      out="$(git -C "$ROOT" merge --ff-only --quiet "$commit" 2>&1)" || { say "$out"; die "$base not updated: the main checkout has uncommitted changes to files the ticket touches — commit or stash them, then squash again"; }
    else
      git -C "$ROOT" fetch --quiet . "$commit:refs/heads/$base" || die "$base moved since the rebase — rebase again"
    fi
    say "squashed $branch onto $base as $(git -C "$ROOT" rev-parse --short "$base")"
    ;;

  pr)
    [ "$branch" != "$base" ] || die "refusing to open a PR from the base branch $base"
    has_origin || die "no origin"
    same_push_url
    td="$(task_dir "$id")"
    need_file "$td/pr-title"; need_file "$td/pr-body.md"
    title="$(head -n 1 "$td/pr-title")"
    [ -n "${title//[[:space:]]/}" ] || die "$td/pr-title has an empty first line"
    pr_template
    if [ -n "$tpl" ]; then
      # shellcheck disable=SC2016
      missing="$(node -e '
        const fs = require("fs")
        const [tplPath, bodyPath, mdCheck] = process.argv.slice(1)
        const { sections } = require(mdCheck)
        const name = (s) => s.name.replace(/\s+#+\s*$/, "").trim()
        const have = new Set(sections(fs.readFileSync(bodyPath, "utf8")).map((s) => name(s).toLowerCase()))
        const seen = new Set(), out = []
        for (const s of sections(fs.readFileSync(tplPath, "utf8"))) {
          const n = name(s), k = n.toLowerCase()
          if (!have.has(k) && !seen.has(k)) { seen.add(k); out.push("## " + n) }
        }
        console.log(out.join(", "))
      ' "$path/$tpl" "$td/pr-body.md" "$(dirname "$(readlink -f "$0")")/../scripts/md-check.js" 2>&1)" ||
        die "could not compare $td/pr-body.md with $(shown "$tpl"): $missing"
      [ -z "$missing" ] || die "$td/pr-body.md lacks the sections of $(shown "$tpl"): $missing"
    fi
    origin_parts
    case "$o_host" in
      github.com)
        repo="$(gh_repo)"
        if got="$(gh_view 2>/dev/null)" && [[ "$got" == *" OPEN "* ]]; then
          [ "$got" = "$base OPEN false" ] || die "PR of $branch is '$got', want '$base OPEN false' (base, state, from a fork)"
          gh pr edit "$branch" --repo "$repo" --body-file "$td/pr-body.md"
        elif [[ "$got" == *" MERGED false" ]]; then
          state="$(gh_pr_state 2>/dev/null)" || state=""
          die "PR of $branch is already merged: ${state#* }"
        else
          gh pr create --repo "$repo" --base "$base" --head "$branch" --title "$title" --body-file "$td/pr-body.md"
        fi
        ;;
      *gitlab*)
        repo="$(glab_repo)"
        if got="$(glab_view 2>/dev/null)" && [[ "$got" == *" opened "* ]]; then
          [ "$got" = "$base opened true" ] || die "MR of $branch is '$got', want '$base opened true' (base, state, same project)"
          glab mr update "$branch" -R "$repo" --description "$(cat "$td/pr-body.md")"
        else
          glab mr create -R "$repo" --target-branch "$base" --source-branch "$branch" --title "$title" --description "$(cat "$td/pr-body.md")" --yes
        fi
        ;;
      *) die "origin is neither github.com nor a GitLab host" ;;
    esac
    ;;

  issue)
    has_origin || die "no origin"
    origin_parts
    [ "$o_host" = github.com ] || die "issue needs a github.com origin"
    draft="$ROOT/.veland/drafts/$id.md"
    need_file "$draft"
    repo="$(gh_repo)"
    { IFS= read -r first || true; } <"$draft"
    [[ "$first" == "# "* ]] || die "$draft: line 1 must be '# <title>'"
    title="${first#\# }"
    [ -n "${title//[[:space:]]/}" ] || die "$draft: empty title"
    labels=(); itype=""; form=""; form_line=0; body_from=2
    while IFS= read -r line; do
      case "$line" in
        "Labels:"*) IFS=',' read -ra parts <<<"${line#Labels:}"
                    for l in ${parts[@]+"${parts[@]}"}; do l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"; [ -n "$l" ] && labels+=("$l"); done ;;
        "Form:"*)   form="${line#Form:}"; form="${form#"${form%%[![:space:]]*}"}"; form="${form%"${form##*[![:space:]]}"}"; form_line=$body_from ;;
        "Type:"*)   itype="${line#Type:}"; itype="${itype#"${itype%%[![:space:]]*}"}"; itype="${itype%"${itype##*[![:space:]]}"}" ;;
        *) break ;;
      esac
      body_from=$((body_from + 1))
    done < <(tail -n +2 "$draft")
    [ -z "$itype" ] || [[ "$itype" =~ ^[A-Za-z0-9][A-Za-z0-9\ _-]*$ ]] || die "invalid issue type '$itype'"
    if [ ${#labels[@]} -gt 0 ]; then
      existing="$(gh label list --repo "$repo" --limit 1000 --json name --jq '.[].name')" || die "could not list labels"
      for l in "${labels[@]}"; do
        printf '%s\n' "$existing" | grep -Fxq -- "$l" || die "label '$l' does not exist in $repo"
      done
    fi
    forms=()
    for f in "$ROOT"/.github/ISSUE_TEMPLATE/*.yml "$ROOT"/.github/ISSUE_TEMPLATE/*.yaml; do
      [ -e "$f" ] || continue
      case "$(basename "$f")" in config.yml|config.yaml) ;; *) forms+=("$f") ;; esac
    done
    formfile=""
    if [ -n "$form" ] || [ ${#forms[@]} -gt 0 ]; then
      [ -n "$form" ] || die "$draft: no 'Form:' header line, but the repo has issue forms; add 'Form: <file>' (one of: $(for f in "${forms[@]}"; do printf '%s ' "$(basename "$f")"; done))"
      [[ "$form" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.ya?ml$ ]] || die "$draft: line $form_line: invalid Form '$form' (a .yml or .yaml file name in .github/ISSUE_TEMPLATE/)"
      case "$form" in config.yml|config.yaml) die "$draft: line $form_line: Form '$form' is not an issue form" ;; esac
      formfile="$ROOT/.github/ISSUE_TEMPLATE/$form"
      [ ! -L "$formfile" ] && [ -f "$formfile" ] || die "$draft: line $form_line: Form '$form' is not a file in .github/ISSUE_TEMPLATE/"
    fi
    banned="$(dirname "$(readlink -f "$0")")/../references/banned-phrases.txt"
    [ -f "$banned" ] || die "$banned is missing"
    # shellcheck disable=SC2016
    problem="$(node -e '
      const fs = require("fs")
      const [draftPath, from, formPath, bannedPath, mdCheck, issueForm] = process.argv.slice(1)
      const { blank, bannedHits } = require(mdCheck)
      const fail = (m) => { console.log(m); process.exit(1) }
      const dl = fs.readFileSync(draftPath, "utf8").split("\n")
      const start = Number(from) - 1 // 0-based index of the first body line
      const form = require(issueForm)
      const parseForm = (text) => {
        try { return form.parseForm(text).body } catch (e) { fail("cannot read " + formPath + ": " + e.message) }
      }
      const norm = (s) => s.trim().toLowerCase()
      const text = blank(dl, start)
      const head = (level, label) => {
        for (let k = start; k < dl.length; k++) {
          const m = text[k] !== null && text[k].match(/^(#+)\s+(.*?)\s*#*\s*$/)
          if (m && m[1].length === level && norm(m[2]) === norm(label)) return k
        }
        return -1
      }
      const section = (k, level) => {
        let e = k + 1
        while (e < dl.length) {
          const m = text[e] !== null && text[e].match(/^(#+)\s/)
          if (m && m[1].length <= level) break
          e++
        }
        return [k + 1, e]
      }
      const content = (a, b) => {
        let s = ""
        for (let k = a; k < b; k++) s += dl[k] + "\n"
        s = s.trim()
        return s === "" || /^_no response_$/i.test(s) ? "" : s
      }
      let crit = null, critHead = -1 // [from, to) of the criteria section, and its heading line
      if (formPath) {
        const fields = parseForm(fs.readFileSync(formPath, "utf8")).filter((f) => f && f.type !== "markdown")
        for (const f of fields) {
          const label = f.attributes && f.attributes.label
          if (typeof label !== "string") fail(formPath + ": a " + f.type + " field has no attributes.label")
          const k = head(3, label)
          const req = f.validations && String(f.validations.required) === "true"
          if (k < 0) { if (req) fail("required field \"" + label + "\": no \"### " + label + "\" section"); continue }
          const [a, b] = section(k, 3)
          if (norm(label) === "acceptance criteria") { crit = [a, b]; critHead = k }
          if (req && content(a, b) === "") fail("line " + (k + 1) + ": required field \"" + label + "\" is empty")
        }
      } else {
        const k = head(2, "Acceptance criteria")
        if (k < 0) fail("no \"## Acceptance criteria\" section")
        crit = section(k, 2); critHead = k
      }
      if (crit && !text.slice(crit[0], crit[1]).some((s) => s !== null && /^\s*[-*+]\s+\[[ xX]\]/.test(s)))
        fail("line " + (critHead + 1) + ": \"Acceptance criteria\" has no checkbox criterion")
      if (crit) for (let k = crit[0]; k < crit[1]; k++) {
        const s = text[k]
        if (s === null) continue
        const m = s.match(/^\s*[-*+]\s+\[[ xX]\]\s*(.*)$/)
        if (!m) continue
        if (/\[[ xX]\]/.test(m[1])) fail("line " + (k + 1) + ": two checkboxes share a line")
        if (!/^AC\d+\s*[\u2014\u2013:-]/.test(m[1])) fail("line " + (k + 1) + ": criterion lacks \"AC<n> —\" (AC number then a dash or colon)")
      }
      const hit = bannedHits(text, bannedPath)[0]
      if (hit) fail("line " + hit.line + ": banned phrase \"" + hit.phrase + "\"")
    ' "$draft" "$body_from" "$formfile" "$banned" "$(dirname "$(readlink -f "$0")")/../scripts/md-check.js" \
      "$(dirname "$(readlink -f "$0")")/../scripts/issue-form.js" 2>&1)" || die "$draft: $problem"
    bodyfile="$(mktemp)"; trap 'rm -f "$bodyfile"' EXIT
    tail -n +"$body_from" "$draft" | sed '1{/^[[:space:]]*$/d;}' >"$bodyfile"
    args=(issue create --repo "$repo" --title "$title" --body-file "$bodyfile")
    for l in ${labels[@]+"${labels[@]}"}; do args+=(--label "$l"); done
    [ -z "$itype" ] || args+=(--type "$itype")
    gh "${args[@]}"
    need_file "$draft"
    rm -f "$draft"
    ;;

  comment)
    has_origin || die "no origin"
    origin_parts
    [ "$o_host" = github.com ] || die "comment needs a github.com origin"
    td="$(task_dir "$id")"
    need_file "$td/comment.md"; need_file "$td/ticket.md"
    repo="$(gh_repo)"
    # The ticket must have been read from this very issue, not #<n> of another repo. Only line 4, the url
    # veland-ticket writes in the header, counts: the issue body and comments below it are anyone's text.
    sed -n 4p "$td/ticket.md" | grep -Fixq -- "- url: https://$repo/issues/$number" || die "$td/ticket.md is not issue #$number of $repo; not commenting"
    gh issue comment "$number" --repo "$repo" --body-file "$td/comment.md"
    # A posted comment is never posted again: a second call finds no comment.md. The earlier comment.posted.md is
    # removed first, so a symlink there cannot make mv write outside .veland/ (rm removes the link, not its target).
    rm -f "$td/comment.posted.md"
    mv -f "$td/comment.md" "$td/comment.posted.md"
    ;;

  *) die "$usage" ;;
esac
